---
import '../styles/rain.css';
import MizukiScene from '../components/MizukiScene.astro';
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>Mingye’s Website · Water &amp; Rain</title>
  <script is:inline src="/rain.js?v=6" defer></script>
</head>
<body>
  <a class="skip" href="#main">跳到正文</a>
  <header class="mast" id="collections">
    <div class="mast-inner">
      <a href="#home" class="wordmark" aria-label="Mingye’s Website 首页"><i class="seal" aria-hidden="true"></i>Mingye’s Website</a>
      <nav aria-label="主导航">
        <a href="#courses">课程</a>
        <a href="#research">科研</a>
        <a href="#projects">项目</a>
      </nav>
      <button id="theme" class="theme" type="button" aria-label="切换到深色主题" title="切换到深色主题"><span aria-hidden="true">☾</span></button>
    </div>
  </header>
  <main id="main" tabindex="-1">
    <div id="home" class="page">
      <section class="hero" aria-label="首页">
        <MizukiScene />
      </section>
    </div>
    <section id="directory" class="page frame interior" hidden>
      <p class="kicker"><i></i><span id="dir-kicker"></span></p>
      <h1 id="dir-title"></h1>
      <div id="dir-content"></div>
    </section>
  </main>
</body>
</html>
