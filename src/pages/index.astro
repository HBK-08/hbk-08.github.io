---
import '../styles/rain.css';
import MizukiScene from '../components/MizukiScene.astro';
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <title>Mingye’s Website · Water &amp; Rain</title>
  <script is:inline src="/rain.js" defer></script>
</head>
<body>
  <a class="skip" href="#main">跳到正文</a>
  <header class="mast">
    <div class="mast-inner">
      <a href="#home" class="wordmark" aria-label="Mingye’s Website 首页"><i class="seal" aria-hidden="true"></i>Mingye’s Website</a>
      <nav aria-label="主导航">
        <a href="#home">Home</a><a href="#courses">Courses</a><a href="#research">Research</a><a href="#projects">Projects</a>
      </nav>
      <button id="theme" class="theme" type="button" aria-label="切换到深色主题" title="切换到深色主题"><span aria-hidden="true">☾</span></button>
    </div>
  </header>
  <main id="main" tabindex="-1">
    <div id="home" class="page">
      <section class="hero" aria-label="首页">
        <MizukiScene />
        <div class="hero-inner">
          <div class="hero-copy">
            <div class="actions"><a class="primary" href="#collections">Explore Notes</a><a class="text-link" href="#research">Research</a></div>
          </div>
        </div>
        <div class="hero-foot">
          <a href="#collections"><i class="scroll-mark" aria-hidden="true"></i>浏览目录</a>
          <div class="scene-tools">
            <button type="button" id="motion-control" aria-controls="jellyfish" hidden>播放动态</button>
            <button type="button" id="cinema-control" aria-pressed="false" hidden>全屏欣赏</button>
            <button class="load-art" id="load-art" type="button"><span aria-hidden="true">＋</span> 载入立绘</button>
          </div>
          <input id="file" type="file" accept="image/*" hidden>
          <span role="status" id="art-status"></span>
        </div>
      </section>
      <section id="collections" class="collections frame" aria-label="笔记分类">
        <a href="#courses" class="shelf course"><small>01</small><div><h2>Courses</h2><p>课程笔记</p></div><i class="motif" aria-hidden="true"></i></a>
        <a href="#research" class="shelf research"><small>02</small><div><h2>Research</h2><p>科研笔记</p></div><i class="motif" aria-hidden="true"></i></a>
        <a href="#projects" class="shelf project"><small>03</small><div><h2>Projects</h2><p>项目记录</p></div><i class="motif" aria-hidden="true"></i></a>
      </section>
    </div>
    <section id="directory" class="page frame interior" hidden>
      <p class="kicker"><i></i><span id="dir-kicker"></span></p>
      <h1 id="dir-title"></h1>
      <div id="dir-content"></div>
    </section>
    <section id="reading" class="page frame interior" hidden>
      <p class="kicker"><i></i><a href="#courses">Courses</a> / Reading</p>
      <div class="reader">
        <aside aria-label="章节目录"><h2>章节目录</h2><div class="rule-set" aria-hidden="true"><i></i><i></i><i></i></div></aside>
        <article><p class="reading-label">LECTURE</p><h1>阅读页预览</h1><p class="muted">此处将显示讲次正文。</p><div class="paper-lines" aria-hidden="true"><i></i><i></i><i></i></div></article>
        <aside aria-label="页内目录"><h2>On this page</h2><div class="rule-set" aria-hidden="true"><i></i><i></i></div></aside>
      </div>
    </section>
  </main>
  <footer class="frame"><a href="#home">Mingye’s Website</a><a href="https://steamcommunity.com/sharedfiles/filedetails/?id=2962933994" target="_blank" rel="noreferrer">壁纸场景 · Over</a></footer>
</body>
</html>
