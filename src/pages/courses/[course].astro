---
import { getCollection } from 'astro:content';
import Shell from '../../layouts/Shell.astro';
import NoteList from '../../components/NoteList.astro';
import { courses, href } from '../../data/courses';
export function getStaticPaths() { return courses.map(course=>({params:{course:course.id},props:{course}})); }
const { course } = Astro.props;
const notes = (await getCollection('notes', n=>n.data.course===course.id)).sort((a,b)=>a.data.order-b.data.order);
---
<Shell title={course.title} description={course.desc} active="courses"><div class="wrap inner">
<a class="crumb" href={href('#courses')}>课程目录</a>
<section class="course-hero"><div><div class="eyebrow">{course.english}</div><h1>{course.title}</h1><p>{course.desc}</p></div><img src={href('art/'+course.id+'.webp')} alt={course.art} width="1440" height="960"/></section>
<section class="block"><header class="section-title"><h2>本课笔记</h2><span>{notes.length} 篇</span></header><NoteList notes={notes}/></section></div></Shell>
