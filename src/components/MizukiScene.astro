<figure class="portrait">
  <div class="scene">
    <img id="mizuki" src="/art/mizuki-caerula-hd.webp"
      srcset="/art/mizuki-caerula-hd.webp 1920w, /art/mizuki-caerula-detail.webp 3838w"
      sizes="max(100vw, 184.35vh)" width="1919" height="1041"
      alt="水月手握透明伞站在岩石上，水母在他身边缓缓漂动" fetchpriority="high">
    <video id="jellyfish" muted loop playsinline preload="none" aria-hidden="true" hidden></video>
  </div>
  <figcaption>
    <span id="art-caption">Mizuki &amp; Caerula Arbor</span>
  </figcaption>
</figure>

<style>
  .portrait, .scene, .scene img, .scene video { position: absolute; inset: 0; width: 100%; height: 100%; margin: 0; }
  .portrait { pointer-events: none; }
  .scene img, .scene video { object-fit: cover; object-position: var(--scene-focus, 50% 50%); }
  figcaption { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>('#jellyfish')!;
  const image = document.querySelector<HTMLImageElement>('#mizuki')!;
  const control = document.querySelector<HTMLButtonElement>('#motion-control')!;
  const originalImage = image.src;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
  let wantsMotion = !reducedMotion.matches;
  let inView = false;
  const hd = '/art/mizuki-jellyfish-hd.mp4';
  const uhd = '/art/mizuki-jellyfish-uhd.mp4';
  let canUseUhd = true;

  function selectVideo() {
    // object-fit: cover can magnify a landscape frame substantially on a narrow phone.
    const box = image.getBoundingClientRect();
    const pixelWidth = Math.max(box.width, box.height * 1919 / 1041) * window.devicePixelRatio;
    const current = video.getAttribute('src');
    const source = canUseUhd && (pixelWidth > 1920 || current === uhd) ? uhd : hd;
    if (source === current) return;
    const time = video.currentTime;
    if (time > 0) video.addEventListener('loadedmetadata', () => { video.currentTime = time; }, { once: true });
    video.hidden = true;
    video.src = source;
  }

  function updatePlayback() {
    const useScene = image.src === originalImage && !video.error;
    control.hidden = !useScene;
    if (!useScene) video.hidden = true;
    control.textContent = wantsMotion ? '暂停动态' : '播放动态';
    if (!useScene || !wantsMotion || !inView || document.hidden) {
      video.pause();
      return;
    }
    selectVideo();
    video.play().catch(error => {
      if (error.name === 'NotAllowedError') {
        wantsMotion = false;
        updatePlayback();
      }
    });
  }

  video.addEventListener('playing', () => { video.hidden = image.src !== originalImage; });
  video.addEventListener('error', () => {
    if (canUseUhd && video.getAttribute('src') === uhd) {
      canUseUhd = false;
      video.removeAttribute('src');
      video.load();
    }
    updatePlayback();
  });
  window.addEventListener('resize', updatePlayback);
  image.addEventListener('load', updatePlayback);
  document.addEventListener('visibilitychange', updatePlayback);
  reducedMotion.addEventListener('change', () => {
    wantsMotion = !reducedMotion.matches;
    updatePlayback();
  });
  control.addEventListener('click', () => {
    wantsMotion = !wantsMotion;
    updatePlayback();
  });
  new IntersectionObserver(([entry]) => {
    inView = entry.isIntersecting;
    updatePlayback();
  }).observe(image);

  const hero = image.closest<HTMLElement>('.hero')!;
  const cinema = document.querySelector<HTMLButtonElement>('#cinema-control')!;
  cinema.hidden = false;
  function setCinema(active: boolean) {
    hero.classList.toggle('cinema', active);
    cinema.setAttribute('aria-pressed', String(active));
    cinema.textContent = active ? '退出全屏' : '全屏欣赏';
  }
  cinema.addEventListener('click', async () => {
    if (hero.classList.contains('cinema')) {
      setCinema(false);
      if (document.fullscreenElement === hero) await document.exitFullscreen();
    } else {
      setCinema(true);
      if (document.fullscreenEnabled) {
        try { await hero.requestFullscreen(); } catch { /* The viewport layout also works without native fullscreen. */ }
      }
    }
  });
  document.addEventListener('fullscreenchange', () => setCinema(document.fullscreenElement === hero));
  document.addEventListener('keydown', event => {
    if (event.key === 'Escape' && !document.fullscreenElement) setCinema(false);
  });
  window.addEventListener('hashchange', () => {
    if (!hero.classList.contains('cinema')) return;
    setCinema(false);
    if (document.fullscreenElement === hero) void document.exitFullscreen();
  });
</script>
